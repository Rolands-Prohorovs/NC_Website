---
import Base from '../../layouts/Base.astro';
import Progress from '../../components/Progress';
import { getCities, getCityLinks } from '../../data/cities';

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { city: city.id }, props: { city } }));
}

const { city } = Astro.props;
const cities = getCityLinks();
---

<Base title={`${city.content[city.languages[0]].ui.nav.progress} · ${city.name}`}>
  <Progress client:load city={city} cities={cities} />
</Base>
