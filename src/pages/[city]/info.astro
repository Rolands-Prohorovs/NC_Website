---
export function getStaticPaths() { // function to generate static paths for the tasks page
  return [
    { params: { city: 'lahti' } }
  ];
}
const { city } = Astro.params;

if (!city) {
  return Astro.redirect('/lahti');
}
---

<main class="page-content">
  <h1>Emergency Phone Numbers</h1>
</main>
