---
import Base from '../layouts/Base.astro';
import Home from '../components/Home';
import { getCities, getCityLinks } from '../data/cities';

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { city: city.id }, props: { city } }));
}

const { city } = Astro.props;
const cities = getCityLinks();
---

<Base title={`${city.name} · ${city.content[city.languages[0]].club}`}>
  <Home client:load city={city} cities={cities} />
</Base>
