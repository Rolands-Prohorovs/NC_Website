---
import Landing from '../components/Landing';
import lahti from '../data/lahti.json';
import riga from '../data/riga.json';

export function getStaticPaths() {
  return [lahti, riga].map((city) => ({ params: { city: city.id }, props: { city } }));
}

const { city } = Astro.props;
const cities = [lahti, riga].map(({ id, name }) => ({ id, name }));
const title = `${city.content.en.welcome} ${city.content.en.tagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Figtree:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Landing client:load city={city} cities={cities} />
  </body>
</html>
