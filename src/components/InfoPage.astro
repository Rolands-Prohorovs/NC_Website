---
/**
 * One component for Students, Living in Lahti and Meet people.
 * Rendered to plain HTML: topics open and close with <details>, so no JavaScript is needed.
 */
import { fmt, type InfoPageId, type Locale } from '../lib/pages';
import type { InfoCopy, SiteCopy } from '../lib/schema';
import LinkList from './LinkList.astro';
import TopicContent from './TopicContent.astro';

const TONES: Record<InfoPageId, string> = {
  students: 'green',
  living: 'blue',
  meet: 'orange',
};

interface Props {
  page: InfoPageId;
  copy: InfoCopy;
  ui: SiteCopy['ui'];
  loc: Locale;
}
const { page, copy, ui, loc } = Astro.props;

const dateFormat = new Intl.DateTimeFormat(loc.lang, { day: 'numeric', month: 'long', year: 'numeric' });
/** "2026-11-03" -> "3 November 2026" / "3. marraskuuta 2026". */
const showDate = (iso: string) => dateFormat.format(new Date(`${iso}T00:00:00Z`));

type Topic = InfoCopy['sections'][number]['topics'][number];
const hasContent = (t: Topic) => !!(t.summary || t.body || t.sections?.length);
---

<section class="hero hero-compact">
  <div class="inner">
    <h1>{copy.title}</h1>
    <p>{copy.subtitle}</p>
  </div>
</section>

{
  copy.sections.length > 1 && (
    <nav class="chips" aria-label={ui.jumpTo}>
      <div class="inner chips-inner">
        {copy.sections.map((s) => (
          <a class="chip" href={`#${s.id}`}>
            {s.title}
          </a>
        ))}
      </div>
    </nav>
  )
}

<main class="inner page" data-tone={TONES[page]}>
  {
    copy.sections.map((s) => (
      <section id={s.id} class="info-section" aria-labelledby={`${s.id}-h`}>
        <h2 id={`${s.id}-h`}>{s.title}</h2>
        {s.intro && <p class="block-hint">{s.intro}</p>}

        <div class="topics">
          {s.topics.map((topic) =>
            hasContent(topic) ? (
              <details class="topic" id={topic.id}>
                <summary>{topic.label}</summary>
                <div class="topic-body">
                  <TopicContent content={topic} ui={ui} loc={loc} />

                  {topic.sections?.map((sub) => (
                    <div class="topic-sub">
                      <h3>{sub.label}</h3>
                      <TopicContent content={sub} ui={ui} loc={loc} />
                    </div>
                  ))}

                  {topic.source && topic.checked && (
                    <p class="topic-source">
                      <a class="source-btn" href={topic.source.url} target="_blank" rel="noreferrer">
                        {ui.officialSource}: {topic.source.label}
                      </a>
                      <span>{fmt(ui.checked, { date: showDate(topic.checked) })}</span>
                    </p>
                  )}
                </div>
              </details>
            ) : (
              <div class="topic topic-empty" id={topic.id}>
                <span>{topic.label}</span>
                <span class="badge" title={ui.comingSoonHint}>
                  {ui.comingSoon}
                </span>
              </div>
            )
          )}
        </div>
      </section>
    ))
  }

  {
    copy.sources && copy.sources.length > 0 && (
      <section class="info-section" aria-labelledby="sources-h">
        <h2 id="sources-h">{ui.sources}</h2>
        <LinkList links={copy.sources} loc={loc} />
      </section>
    )
  }
</main>
