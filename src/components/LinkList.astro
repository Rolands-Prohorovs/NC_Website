---
import type { TopicLink } from '../lib/schema';

interface Props {
  links?: TopicLink[];
}
const { links } = Astro.props;
---

{
  links && links.length > 0 && (
    <ul class="topic-links">
      {links.map((l) => (
        <li>
          <a href={l.url} target="_blank" rel="noreferrer">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
